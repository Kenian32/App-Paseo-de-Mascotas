{
  "name": "paseo-mascotas",
  "version": "0.1.0",
  "description": "App web de paseo de mascotas (monolito en capas: Node.js, Express, MySQL 8)",
  "main": "app.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "db:init": "node scripts/db-init.js",
    "db:reset": "node scripts/db-init.js --reset",
    "humo": "node scripts/prueba-humo.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.10.1"
  }
}
