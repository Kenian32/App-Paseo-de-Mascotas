# Copia este archivo como .env y completa tus datos. Nunca subas .env al repositorio.

# Servidor
PORT=3000
NODE_ENV=development

# Zona horaria del negocio (los paseos y recordatorios usan esta hora)
TZ=America/Guayaquil

# Reporte de cobros en CSV: separador y coma decimal para Excel en español (para Excel en inglés usa , y .)
CSV_SEPARADOR=;
CSV_DECIMAL=,

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=paseo_mascotas
DB_POOL=10

# Contraseña de desarrollo que npm run db:init asigna (con hash bcrypt) a los usuarios de ejemplo
DEV_PASSWORD=Cambiar123

# Sesión (cookie firmada, expira a los 15 minutos, RNF-03). Usa un texto largo y aleatorio.
SESSION_SECRET=cambia-este-secreto

# Correo SMTP (contraseñas temporales, recordatorios y avisos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Paseos <no-reply@paseos.ec>
